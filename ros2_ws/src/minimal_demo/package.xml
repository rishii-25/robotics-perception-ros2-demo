  <version>0.0.1</version>
  <description>Minimal ROS2 publisher/subscriber demo for robotics track prep</description>
  <maintainer email="rishik25t4@gmail.com">rishik</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
